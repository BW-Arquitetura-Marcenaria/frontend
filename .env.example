# URL do backend
VITE_API_BASE_URL=http://localhost:8080
# true = usa dados mockados na Rastreabilidade (sem backend)
VITE_USE_MOCK=false
# Chave da API do Google Maps (Geocoding / Places). Coloque sua chave aqui para habilitar o mapa.
VITE_GOOGLE_MAPS_KEY=
# Destino do proxy de dev da geração por IA (FLUX.2 [flex]).
# Deixe vazio para usar o mock local (npm run mock:api, porta 4000).
# Em produção, aponte para o backend que guarda a chave de API:
# VITE_FLUX_PROXY_TARGET=http://localhost:8080
VITE_FLUX_PROXY_TARGET=

