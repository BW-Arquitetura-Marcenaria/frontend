# URL do backend
VITE_API_BASE_URL=http://localhost:8080
# true = usa dados mockados na Rastreabilidade (sem backend)
VITE_USE_MOCK=false
# Chave da API do Google Maps (Geocoding / Places). Coloque sua chave aqui para habilitar o mapa.
VITE_GOOGLE_MAPS_KEY=
# ─── Simulação por IA (FLUX.2 [flex] no Azure AI Foundry) ───────────────────
# Chave de API do recurso Foundry. Só fica no servidor de dev (proxy do Vite);
# nunca é exposta ao browser. Sem ela, a geração por IA roda em modo mock.
# Preencha no seu .env local (que NÃO é versionado).
VITE_FLUX_API_KEY=
# Endpoint completo do modelo (opcional — há um padrão no vite.config.ts).
# VITE_FLUX_ENDPOINT=https://<seu-recurso>.services.ai.azure.com/providers/blackforestlabs/v1/flux-2-flex?api-version=preview
# Nome do modelo (opcional — padrão "FLUX.2-flex").
VITE_FLUX_MODEL=

